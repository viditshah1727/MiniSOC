# MiniSOC API configuration.
# Copy to `.env` (git-ignored) and adjust. Never commit real secrets.

# PostgreSQL connection string (matches docker-compose.yml)
DATABASE_URL="postgresql://minisoc:minisoc@localhost:5432/minisoc"

# Secret that signs login tokens (JWT). Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-secret-at-least-32-chars"

# How long a login session lasts, in hours (a SOC shift)
SESSION_HOURS=8

# HTTP port for the API
PORT=4000

# Browser origin(s) allowed to call the API, comma-separated (Vite dev server)
CORS_ORIGIN="http://localhost:5173"

# Demo-only attack simulator (POST /api/simulate). Set to false in production.
ENABLE_SIMULATION=true

# Password for the demo accounts created by `npm run db:seed`
SEED_DEMO_PASSWORD="MiniSOC-demo-2026"

# Optional: enables the "Analyze with AI" assistant on the alert page.
# Leave empty to disable it; the SOC works fully without AI.
ANTHROPIC_API_KEY=""
