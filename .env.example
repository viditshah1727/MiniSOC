# MiniSOC configuration — copy to `.env` and fill in real values.
# The .env file is git-ignored; never commit real secrets.

# Flask session signing key. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Password assigned to the seeded 'analyst' user when the DB is seeded.
DEFAULT_ANALYST_PASSWORD=ChangeMe_123!

# Optional overrides
# DATABASE_URL=sqlite:////absolute/path/to/minisoc.db
# PORT=5000
# FLASK_DEBUG=0
