# MiniSOC configuration — copy to `.env` and fill in real values.
# The .env file is git-ignored; never commit real secrets.

# Flask session signing key. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Analyst account created when the database is seeded.
# If DEFAULT_ANALYST_PASSWORD is left as CHANGE_ME (or unset), the seed
# script generates a random password and prints it once.
DEFAULT_ANALYST_USERNAME=analyst
DEFAULT_ANALYST_PASSWORD=CHANGE_ME

# Optional overrides
# DATABASE_URL=sqlite:////absolute/path/to/minisoc.db
# PORT=5000
# FLASK_DEBUG=0
